# wamock (image ghcr.io/alrashidmtz/wamock)
# Samakan dengan webhook_verify_token di WhatsApp Account Frappe.
WEBHOOK_VERIFY_TOKEN=
WEBHOOK_APP_SECRET=local-dev
# Endpoint webhook Frappe, dijangkau dari network frappe_default.
WEBHOOK_URL=http://frappe:8001/api/method/frappe_whatsapp.utils.webhook.webhook
# Port wamock di host (container selalu 4004).
WAMOCK_HOST_PORT=4005

# Dipakai wamock dan bridge. Samakan dengan phone_id / business_id WhatsApp Account Frappe.
WAMOCK_PHONE_ID=123xxx
WAMOCK_WABA=123xxx
WAMOCK_VERSION=v25.0

# bridge: alamat wamock dari dalam compose. Dari host (npm run seed) pakai http://localhost:4005.
WAMOCK_URL=http://wamock:4004
